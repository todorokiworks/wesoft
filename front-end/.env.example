# microCMS（.env.local にコピーして利用。本ファイルには実キーを書かないこと）
REACT_APP_MICROCMS_SERVICE_DOMAIN=your-service-id
REACT_APP_MICROCMS_API_KEY=your-api-key

# コラム API エンドポイント名
REACT_APP_MICROCMS_ARTICLE_ENDPOINT=wesoft-column
REACT_APP_MICROCMS_CATEGORY_ENDPOINT=categories

# column.json → microCMS インポート用（npm run import:column）
# 管理画面で POST/PATCH・メディアのアップロード権限を付与したキー
MICROCMS_WRITE_API_KEY=your-write-api-key

# GitHub Pages 相当のベースパスでローカル確認する場合（npm run start:ghpages で自動設定）
# REACT_APP_BASE_PATH=/wesoft
